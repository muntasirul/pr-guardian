# Copy to .env and fill in what you need. Everything is optional for the mock/demo path.

# GitHub token (enables fetching PR diffs and posting inline review comments)
GITHUB_TOKEN=

# Inference: 1 = heuristic mock model (no torch needed), 0 = real model
PRGUARDIAN_MOCK=1
# LoRA adapter directory (e.g. models/verdict-v1). Empty = base model, no fine-tuning.
ADAPTER_PATH=
MIN_CONFIDENCE=0.55

# Zero-shot API baseline (OpenAI-compatible endpoint)
PRGUARDIAN_API_KEY=
PRGUARDIAN_API_BASE=https://api.openai.com/v1
PRGUARDIAN_API_MODEL=gpt-4o-mini

# Local zero-shot baseline via ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct

# Optional infra
DATABASE_URL=sqlite:///./reviews.db
REDIS_URL=
QDRANT_URL=
